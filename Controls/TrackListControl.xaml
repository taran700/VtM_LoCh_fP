<UserControl x:Class="VtM_LoCh_fP.Controls.TrackListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VtM_LoCh_fP.Controls"
             x:Name="Root">
    <ItemsControl ItemsSource="{Binding Names, ElementName=Root}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <controls:TrackControl
                    Label="{Binding}"
                    Count="{Binding Count, RelativeSource={RelativeSource AncestorType={x:Type controls:TrackListControl}}}"
                    Shape="{Binding Shape, RelativeSource={RelativeSource AncestorType={x:Type controls:TrackListControl}}}"
                    Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType={x:Type controls:TrackListControl}}}"
                    LabelWidth="{Binding LabelWidth, RelativeSource={RelativeSource AncestorType={x:Type controls:TrackListControl}}}"
                    IsEditableLabel="{Binding IsEditableLabel, RelativeSource={RelativeSource AncestorType={x:Type controls:TrackListControl}}}"
                    Cascade="{Binding Cascade, RelativeSource={RelativeSource AncestorType={x:Type controls:TrackListControl}}}"
                    ShowNote="{Binding ShowNotes, RelativeSource={RelativeSource AncestorType={x:Type controls:TrackListControl}}}"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
