<UserControl x:Class="VtM_LoCh_fP.Controls.TrackListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VtM_LoCh_fP.Controls"
             x:Name="Root">
    <ItemsControl ItemsSource="{Binding Names, ElementName=Root}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <controls:TrackControl
                    Label="{Binding}"
                    Count="{Binding Count, ElementName=Root}"
                    Shape="{Binding Shape, ElementName=Root}"
                    Columns="{Binding Columns, ElementName=Root}"
                    LabelWidth="{Binding LabelWidth, ElementName=Root}"
                    IsEditableLabel="{Binding IsEditableLabel, ElementName=Root}"
                    Cascade="{Binding Cascade, ElementName=Root}"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
