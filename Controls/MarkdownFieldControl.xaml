<UserControl x:Class="VtM_LoCh_fP.Controls.MarkdownFieldControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
             xmlns:ae="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             x:Name="Root"
             PreviewMouseWheel="Root_PreviewMouseWheel">
    <UserControl.Resources>
        <!-- MdXaml для отображения МД -->
        <Style TargetType="{x:Type ae:TextEditor}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>
    <StackPanel x:Name="LayoutRoot">
        <TextBlock Text="{Binding Label, ElementName=Root}"
                   Style="{StaticResource FieldLabelStyle}"
                   Margin="0,0,0,3" />
        <Border x:Name="FieldBorder"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Background="{DynamicResource InputBrush}"
                Padding="5"
                MinHeight="42">
            <Grid x:Name="ContentHost">
                <md:MarkdownScrollViewer x:Name="Preview"
                    Markdown="{Binding InputText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                    MarkdownStyleName="Sasabune"
                    ClickAction="SafetyOpenBrowser"
                    Visibility="Visible"
                    MinHeight="32"
                    VerticalAlignment="Top"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    Foreground="{DynamicResource TextBrush}"
                    Background="Transparent"
                    BorderThickness="0"
                    Focusable="True"
                    SizeChanged="Preview_SizeChanged"
                    PreviewMouseWheel="Root_PreviewMouseWheel" />
                <TextBox x:Name="Editor"
                    Visibility="Collapsed"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    VerticalContentAlignment="Top"
                    HorizontalContentAlignment="Left"
                    Padding="3"
                    Background="{DynamicResource InputBrush}"
                    Foreground="{DynamicResource TextBrush}"
                    CaretBrush="{DynamicResource AccentBrush}"
                    BorderThickness="0"
                    VerticalScrollBarVisibility="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    TextChanged="Editor_TextChanged"
                    LostKeyboardFocus="Editor_LostKeyboardFocus"
                    SizeChanged="Editor_SizeChanged"
                    PreviewMouseWheel="Root_PreviewMouseWheel"
                    MinHeight="32" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
