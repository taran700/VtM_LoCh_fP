<UserControl x:Class="VtM_LoCh_fP.Controls.TrackControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="2,1,2,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LabelColumn" Width="160"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LabelText" Grid.Column="0"
                   Text="{Binding Label, ElementName=Root}"
                   Style="{StaticResource FieldLabelStyle}"
                   VerticalAlignment="Center"/>

        <TextBox x:Name="LabelInput" Grid.Column="0" Visibility="Collapsed"
                 Text="{Binding Label, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14" MinHeight="26" Padding="5,3" Margin="0,1,4,1"
                 VerticalAlignment="Center" ToolTip="Введите название"/>

        <!-- Круглые точки -->
        <ItemsControl x:Name="DotItems" Grid.Column="1"
                      ItemsSource="{Binding Items, ElementName=Root}"
                      CheckBox.Checked="Pip_Checked" CheckBox.Unchecked="Pip_Unchecked"
                      VerticalAlignment="Center" Height="35">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Style="{StaticResource DotPipStyle}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Квадраты -->
        <ItemsControl x:Name="SquareItems" Grid.Column="1" Visibility="Collapsed"
                      ItemsSource="{Binding Items, ElementName=Root}"
                      CheckBox.Checked="Pip_Checked" CheckBox.Unchecked="Pip_Unchecked"
                      VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="0" Columns="10"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Style="{StaticResource SquarePipStyle}"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl x:Name="SquareItemsH" Grid.Column="1" Visibility="Collapsed"
               ItemsSource="{Binding Items, ElementName=Root}"
               CheckBox.Checked="Pip_Checked" CheckBox.Unchecked="Pip_Unchecked"
               VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Style="{StaticResource SquarePipStyle}"
                       IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Line x:Name="ForcedZeroStrike" Grid.Column="0" Grid.ColumnSpan="2"
              X1="0" Y1="31" X2="285" Y2="2"
              Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
              HorizontalAlignment="Left" VerticalAlignment="Center"
              IsHitTestVisible="False" Visibility="Collapsed"/>
        <Line x:Name="ForcedZeroStrikeSecond" Grid.Column="0" Grid.ColumnSpan="2"
              X1="0" Y1="35" X2="285" Y2="6"
              Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
              HorizontalAlignment="Left" VerticalAlignment="Center"
              IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>
</UserControl>
