<UserControl x:Class="VtM_LoCh_fP.Controls.FieldControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Margin="2,0,4,4">
        <TextBlock Text="{Binding Label, ElementName=Root}"
                   Style="{StaticResource FieldLabelStyle}"/>
        <TextBox x:Name="Input"
                 Height="{Binding FieldHeight, ElementName=Root}" MinHeight="{Binding FieldHeight, ElementName=Root}"
                 AcceptsReturn="{Binding Multiline, ElementName=Root}"
                 TextWrapping="{Binding WrapMode, ElementName=Root}"
                 VerticalScrollBarVisibility="{Binding ScrollMode, ElementName=Root}"
                 HorizontalContentAlignment="Left" TextAlignment="Left"/>
    </StackPanel>
</UserControl>
