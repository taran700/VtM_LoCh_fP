<UserControl x:Class="VtM_LoCh_fP.Controls.HealthTrackControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Отметка здоровья: одна палка, затем крест (две палки), затем пусто.
             Палки специально выходят за рамку квадрата — ClipToBounds=False
             и размер шрифта больше стороны квадрата. -->
        <Style x:Key="WoundMarkStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="6,2,6,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="32" Height="32" ClipToBounds="False" Background="Transparent">
                            <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                    CornerRadius="2"/>
                            <Canvas ClipToBounds="False">
                                <!-- Одна палка: диагональ из левого нижнего в правый верхний угол -->
                                <TextBlock x:Name="OneSlash" Text="/" FontSize="46" FontWeight="Bold"
                                           Foreground="{TemplateBinding Foreground}"
                                           Canvas.Left="-3" Canvas.Top="-9" Visibility="Collapsed"
                                           IsHitTestVisible="False"/>
                                <!-- Вторая палка добавляется вторым нажатием -->
                                <TextBlock x:Name="TwoSlash" Text="/" FontSize="46" FontWeight="Bold"
                                           Foreground="{TemplateBinding Foreground}"
                                           Canvas.Left="11" Canvas.Top="-9" Visibility="Collapsed"
                                           IsHitTestVisible="False"/>
                            </Canvas>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding State}" Value="1">
                                <Setter TargetName="OneSlash" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="2">
                                <Setter TargetName="OneSlash" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TwoSlash" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,1,2,1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ItemsControl Grid.Column="0" ItemsSource="{Binding Levels, ElementName=Root}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabelStyle}"
                               FontWeight="Normal" MinHeight="36" Padding="0,0,4,0"
                               VerticalAlignment="Center"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl Grid.Column="1" ItemsSource="{Binding Levels, ElementName=Root}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource WoundMarkStyle}"
                            Click="Mark_Click"
                            HorizontalAlignment="Left"
                            ToolTip="{Binding Name}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
