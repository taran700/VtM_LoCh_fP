{
  "schema_version": 1,
  "description": "Паттерны случайной генерации персонажей VtM V20. Порядок элементов в списках сохраняет приоритет, но сам алгоритм выбора и веса задаются генератором.",
  "generation_rules": {
    "name_selection": {
      "source": "name_profiles",
      "mode": "uniform_random"
    },
    "sire_name_selection": {
      "source": "opposite_gender_name_profiles",
      "mode": "uniform_random"
    },
    "apparent_age": {
      "min": 16,
      "max": 97
    },
    "death_date": {
      "year": "birth_year + apparent_age",
      "month": {
        "min": 1,
        "max": 12
      },
      "day": {
        "min": 1,
        "max": 28
      }
    },
    "height_cm": {
      "min": 100,
      "max": 214
    },
    "weight_kg": {
      "min": 29,
      "max": 130
    },
    "virtues": {
      "mode": "random_with_standard_creation_rules"
    },
    "merits_and_flaws": {
      "enabled": false
    },
    "disciplines": {
      "source": "selected_clan_clan_disciplines",
      "mode": "random_selection_and_dot_distribution"
    },
    "attribute_dots": {
      "mode": "random_with_standard_creation_rules",
      "priority_source": "clan_attribute_priority"
    },
    "ability_dots": {
      "mode": "random_with_standard_creation_rules",
      "priority_source": "name_profile.ability_priority"
    },
    "backgrounds": {
      "priority_source": "name_profile.background_priority"
    },
    "freebie_points": {
      "total": 15,
      "guaranteed_purchase": {
        "type": "increase_random_selected_discipline_once",
        "cost": 7
      },
      "remaining_purchase": {
        "mode": "single_weighted_choice",
        "available_points": 8,
        "options": [
          {
            "type": "increase_random_attribute",
            "chance_percent": 25,
            "cost": 5
          },
          {
            "type": "increase_three_already_selected_abilities",
            "chance_percent": 25,
            "cost": 6
          },
          {
            "type": "buy_three_background_dots_and_one_new_ability",
            "chance_percent": 50,
            "cost": "calculated_by_standard_freebie_costs"
          }
        ]
      },
      "unspent_points": {
        "distribution": "humanity_and_willpower",
        "odd_point_to": "willpower",
        "respect_maximums": true,
        "if_maximum_reached": "leave_remaining_points_unspent"
      }
    },
    "birth_date": {
      "year": {
        "min": 1400,
        "max": 2007
      },
      "month": {
        "mode": "random_valid_calendar_month"
      },
      "day": {
        "mode": "random_valid_calendar_day"
      }
    }
  },
