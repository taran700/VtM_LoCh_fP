<Window x:Class="VtM_LoCh_fP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VtM_LoCh_fP.Views"
        Title="VtM V20: Лист персонажа" Height="940" Width="1360"
        MinHeight="600" MinWidth="980"
        Background="{DynamicResource BgBrush}"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        TextOptions.TextFormattingMode="Display"
        FontSize="15">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель: заголовок и переключение темы -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Настройки" Style="{StaticResource ToolbarButtonStyle}"
                            Click="Settings_Click"/>
                </StackPanel>
                <TextBlock 
                           Foreground="{DynamicResource HeadingBrush}"
                           FontWeight="Bold" FontSize="20" VerticalAlignment="Center">
                           <Run Text ="VAMPIRE : THE MASQUERADE" FontFamily="{StaticResource VampiricLabel}"/>
                           <Run Text= "20TH ANNIVERSARY EDITIONE" FontFamily="{StaticResource VampiricLabel}"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Вкладки-страницы. Перетаскиваются, чтобы менять порядок. -->
        <TabControl x:Name="SheetTabs" Grid.Row="1"
                    Style="{StaticResource SheetTabControlStyle}"
                    ItemContainerStyle="{StaticResource SheetTabItemStyle}"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="Tabs_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Tabs_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="Tabs_PreviewMouseLeftButtonUp"
                    DragOver="Tabs_DragOver"
                    Drop="Tabs_Drop"
                    SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Лист">
                
                <views:PageOneView x:Name="CharacterPage"/>
            </TabItem>
            <TabItem Header="Преимущества">
                <views:PageTwoView x:Name="AdvantagesPage"/>
            </TabItem>
            <TabItem Header="Дисциплины">
                <views:PageThreeView/>
            </TabItem>
            <TabItem Header="Достоинства и история">
                <views:PageFourView/>
            </TabItem>
            <TabItem Header="Заметки">
                <views:PageFiveView/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
