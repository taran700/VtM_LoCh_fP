<Window x:Class="VtM_LoCh_fP.MainWindow"
        Icon="Resources/Vampiric.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VtM_LoCh_fP.Views"
        Title="VtM V20: Лист персонажа" Height="940" Width="1360"
        MinHeight="600" MinWidth="980"
        Background="{DynamicResource BgBrush}"
        TextOptions.TextFormattingMode="Display"
        FontSize="15">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="InitialPurchaseButton" Content="Проверить стартовую закупку" Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,8,0" Click="InitialPurchase_Click" Visibility="Collapsed"/>
                    <Button x:Name="FreebieJournalButton" Content="Просмотреть закуп за свободные пункты" Style="{StaticResource ToolbarButtonStyle}"
                            Margin="0,0,8,0" Visibility="Collapsed" Click="FreebieJournal_Click"/>
                    <Button Content="Настройки" Style="{StaticResource ToolbarButtonStyle}" Click="Settings_Click"/>
                </StackPanel>
                <TextBlock 
                           Foreground="{DynamicResource HeadingBrush}"
                           FontWeight="Bold" FontSize="20" VerticalAlignment="Center">
                           <Run Text ="VAMPIRE : THE MASQUERADE" FontFamily="{StaticResource VampiricLabel}"/>
                           <Run Text= "20TH ANNIVERSARY EDITIONE" FontFamily="{StaticResource VampiricLabel}"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Вкладки -->
        <TabControl x:Name="SheetTabs" Grid.Row="1"
                    Style="{StaticResource SheetTabControlStyle}"
                    ItemContainerStyle="{StaticResource SheetTabItemStyle}"
                    SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Лист">
                
                <views:PageOneView x:Name="CharacterPage"/>
            </TabItem>
            <TabItem Header="Преимущества">
                <views:PageTwoView x:Name="AdvantagesPage"/>
            </TabItem>
            <TabItem Header="Дисциплины">
                <views:PageThreeView x:Name="DisciplinesPage"/>
            </TabItem>
            <TabItem Header="Достоинства и история">
                <views:PageFourView x:Name="HistoryPage"/>
            </TabItem>
            <TabItem Header="Снаряжение">
                <views:PageSixView x:Name="EquipmentPage"/>
            </TabItem>
            <TabItem Header="Заметки">
                <views:PageFiveView x:Name="NotesPage"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
