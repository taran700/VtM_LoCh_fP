<Application x:Class="VtM_LoCh_fP.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
                <!-- Кастомные  Шрифты -->
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="VampiricLabel">/Fonts/#Friz Quadrata</FontFamily>
            <FontFamily x:Key="VampricCat">/Fonts/#Playfair Display</FontFamily>
            <FontFamily x:Key="VampiricText">/Fonts/#Trajan Pro 3</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
