<Application x:Class="VtM_LoCh_fP.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Индекс 0: палитра темы. Её подменяет ThemeManager. -->
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                
                <!-- Стили обращаются к палитре через DynamicResource, поэтому
                     при смене темы перекрашиваются автоматически. -->
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="VampiricLabel">/Fonts/#Friz Quadrata</FontFamily>
            <FontFamily x:Key="VampricCat">/Fonts/#Playfair Display</FontFamily>
            <FontFamily x:Key="VampiricText">/Fonts/#Trajan Pro 3</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
