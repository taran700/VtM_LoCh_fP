<UserControl x:Class="VtM_LoCh_fP.Views.PageTwoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:VtM_LoCh_fP.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14,16,20">
            <DockPanel Margin="4,0,4,12">
                <TextBlock DockPanel.Dock="Right" Text="2/5" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="ПРЕИМУЩЕСТВА" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}"/>
            </DockPanel>
            <!-- ===== Преимущества ===== -->
            <GroupBox Header="ПРЕИМУЩЕСТВА" Style="{StaticResource SectionBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
   
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                   
                       

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Факты биографии" Style="{StaticResource FieldLabelStyleB}" FontSize="22"/>
                        <controls:TrackListControl Cascade="True" Count="5" LabelWidth="170" IsEditableLabel="True">
                            <controls:TrackListControl.Names>
                                <sys:String>Факт биографии</sys:String>
                                <sys:String>Факт биографии</sys:String>
                                <sys:String>Факт биографии</sys:String>
                                <sys:String>Факт биографии</sys:String>
                                <sys:String>Факт биографии</sys:String>
                            </controls:TrackListControl.Names>
                        </controls:TrackListControl>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Добродетели" Style="{StaticResource FieldLabelStyleB}" FontSize="22"/>
                        <controls:TrackListControl Cascade="True" Count="5" LabelWidth="190" VerticalAlignment="Center">
                            <controls:TrackListControl.Names>
                                <sys:String>Совесть / Решимость</sys:String>
                                <sys:String>Самоконтроль / Инстинкты</sys:String>
                                <sys:String>Смелость</sys:String>
                            </controls:TrackListControl.Names>
                        </controls:TrackListControl>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- ===== Состояние персонажа =====
                 Воля: постоянная и временная — одна строка строго под другой,
                 для этого у обеих дорожек одинаковая ширина подписи и одинаковое
                 число точек. Кровь: 10 квадратов всегда в два ряда по пять. -->
            <GroupBox  Header="МЕНТАЛЬНЫЙ РЕСУРС" 
                      Style="{StaticResource SectionBoxStyle}"  >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Человечность / Путь" Style="{StaticResource FieldLabelStyleB}" FontSize="22"/>
                        <controls:TrackControl Label="Степень" Count="10" LabelWidth="110"
                                               Shape="Dots" Cascade="True"/>
                        <controls:FieldControl Label="Столп"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Воля" Style="{StaticResource FieldLabelStyleB}" FontSize="22"/>
                        <controls:TrackControl Label="Постоянная" Count="10" LabelWidth="120"
                                               Shape="Dots" Cascade="True"/>
                        <controls:TrackControl Label="Временная" Count="10" LabelWidth="120"
                                               Shape="SquaresH" Columns="5" Cascade="True" Loaded="TrackControl_Loaded" />
                    </StackPanel>

                    
                </Grid>
            </GroupBox>

            <GroupBox
                Header="ФИЗИЧЕСКИЙ РЕСУРС" Style="{StaticResource SectionBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Запас крови" Style="{StaticResource FieldLabelStyleB}" FontSize="22"/>
                        <controls:TrackControl Label="Кровь" Count="10" LabelWidth="100"
                                               Shape="Squares" Columns="5" Cascade="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Здоровье" Style="{StaticResource FieldLabelStyleB}" FontSize="22"/>
                        <controls:TrackControl Label="Здоровье" Count="7" LabelWidth="100"
                                               Shape="Squares" Columns="5" Cascade="True"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- ===== Опыт ===== -->
            <GroupBox Header="Опытность" Style="{StaticResource SectionBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                       
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    
                    </Grid.ColumnDefinitions>
               
                    <controls:FieldControl Grid.Column="0" Label="Опыт"/>
                    <controls:FieldControl Grid.Column="1" Label="Свободные пункты"/>
                   
                </Grid>
            </GroupBox>
            

        </StackPanel>
    </ScrollViewer>
</UserControl>
