<UserControl x:Class="VtM_LoCh_fP.Views.PageTwoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:VtM_LoCh_fP.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14,16,20">
            <DockPanel Margin="4,0,4,12">
                <TextBlock DockPanel.Dock="Right" Text="2/6" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="ПРЕИМУЩЕСТВА" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}"/>
            </DockPanel>

            <GroupBox Header="ПРЕИМУЩЕСТВА" Style="{StaticResource SectionBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
   
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                   
                       

                    <StackPanel Grid.Column="0">
                        <DockPanel LastChildFill="False" Margin="0,0,0,5" VerticalAlignment="Center">
                            <TextBlock Text="Факты биографии" Style="{StaticResource FieldLabelStyleB}" FontSize="22"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="AddBioFactButton" Content="＋ Добавить факт"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Padding="12,6" Margin="12,0,0,0"
                                    FontWeight="SemiBold" FontSize="14"
                                    VerticalAlignment="Center"
                                    Click="AddBioFact_Click"/>
                        </DockPanel>
                        <ScrollViewer x:Name="BioFactsScrollViewer" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="BioFactsScrollViewer_PreviewMouseWheel">
                            <StackPanel x:Name="BioFactsPanel"/>
                        </ScrollViewer>
                        <TextBlock x:Name="BackgroundRemainingLabel" Margin="0,6,0,3"/>
                        <Button x:Name="ConfirmBackgroundsButton" Content="Подтвердить факты биографии" Padding="10,5" HorizontalAlignment="Left" Click="ConfirmBackgrounds_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="VirtuesHeader" Text="Добродетели" Style="{StaticResource FieldLabelStyleB}" FontSize="22"/>
                        <controls:TrackListControl x:Name="VirtuesTrackList" Cascade="True" Count="5" LabelWidth="190" VerticalAlignment="Center">
                            <controls:TrackListControl.Names>
                                <sys:String>Совесть</sys:String>
                                <sys:String>Самоконтроль</sys:String>
                                <sys:String>Смелость</sys:String>
                            </controls:TrackListControl.Names>
                        </controls:TrackListControl>
                        <TextBlock x:Name="VirtuesRemainingLabel" Margin="0,6,0,3"/>
                        <Button x:Name="ConfirmVirtuesButton" Content="Подтвердить добродетели" Padding="10,5" HorizontalAlignment="Left" Click="ConfirmVirtues_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox  Header="МЕНТАЛЬНЫЙ РЕСУРС" 
                      Style="{StaticResource SectionBoxStyle}"  >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Человечность / Путь" Style="{StaticResource FieldLabelStyleB}" FontSize="22" Margin="0,0,0,5"/>
                        <ComboBox x:Name="HumanityPathCombo" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  MinHeight="30" Margin="0,0,8,5" Padding="6,3"
                                  SelectionChanged="HumanityPathCombo_SelectionChanged"/>
                        <DockPanel x:Name="HumanityPathNeonatePicker" LastChildFill="True" Margin="0,0,8,5" Visibility="Collapsed">
                            <Button x:Name="CreateHumanityPathButton" Content="Создать" Padding="10,4" Margin="6,0,0,0"
                                    Click="CreateHumanityPath_Click" Visibility="Collapsed"/>
                            <TextBox x:Name="HumanityPathInput" MinHeight="30" Padding="6,3"
                                     TextChanged="HumanityPathInput_TextChanged" KeyDown="HumanityPathInput_KeyDown"/>
                        </DockPanel>
                        <Popup x:Name="HumanityPathSuggestionsPopup" PlacementTarget="{Binding ElementName=HumanityPathInput}"
                               Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border BorderThickness="1" CornerRadius="4" Padding="3" MaxHeight="220"
                                    Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                <ListBox x:Name="HumanityPathSuggestions" DisplayMemberPath="Name" MinWidth="250"
                                         BorderThickness="0" SelectionChanged="HumanityPathSuggestions_SelectionChanged"
                                         MouseUp="HumanityPathSuggestions_MouseUp"/>
                            </Border>
                        </Popup>
                        <DockPanel Margin="2,2,0,5" LastChildFill="False">
                            <TextBlock x:Name="HumanityPathName" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="···" FontSize="18" Padding="5,0" Margin="7,0,0,0" ToolTip="Информация о Пути" Click="HumanityPathInfo_Click"/>
                        </DockPanel>
                        <controls:TrackControl x:Name="HumanityPathTrack" Label="Уровень" Count="10" LabelWidth="110"
                                               Shape="Dots" Cascade="True"/>
                        <WrapPanel Margin="0,7,0,0">
                            <Button x:Name="HumanitySinTableButton" Content="Таблица грехов" Padding="10,5" Margin="0,0,7,0"
                                    Click="HumanitySinTable_Click"/>
                            <Button x:Name="EditHumanityPathButton" Content="Редактировать Путь" Padding="10,5"
                                    Click="EditHumanityPath_Click" Visibility="Collapsed"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="WillpowerHeader" Text="Воля" Style="{StaticResource FieldLabelStyleB}" FontSize="22"
                                   />
                        <controls:TrackControl x:Name="WillpowerPermanentTrack" Label="Постоянная" Count="10" LabelWidth="120"
                                               Shape="Dots" Cascade="True"/>
                        <controls:TrackControl x:Name="WillpowerTemporaryTrack" Label="Временная" Count="10" LabelWidth="120"
                                               Shape="SquaresH" Columns="5" Cascade="True" Loaded="TrackControl_Loaded" />
                    </StackPanel>

                    
                </Grid>
            </GroupBox>

            <GroupBox
                Header="ФИЗИЧЕСКИЙ РЕСУРС" Style="{StaticResource SectionBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Запас крови" Style="{StaticResource FieldLabelStyleB}" FontSize="22"/>
                        <controls:TrackControl x:Name="BloodTrack" Label="Кровь" Count="10" LabelWidth="100"
                                               Shape="Squares" Columns="5" Cascade="True"/>
                        <TextBlock x:Name="BloodPerTurnText" Text="Трата за ход: 1 пункт" Margin="4,5,0,0"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="13"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <DockPanel LastChildFill="False" Margin="0,0,0,5">
                            <TextBlock x:Name="HealthHeader" Text="Здоровье" Style="{StaticResource FieldLabelStyleB}" FontSize="22" VerticalAlignment="Center" ToolTip="Лёгкие повреждения — синяки, ссадины, ушибы: быстро заживают, редко смертельны.&#10;Тяжёлые повреждения — глубокие раны, переломы, серьёзный ущерб: смертного могут убить быстро, вампиру доставляют временные неудобства.&#10;Губительные повреждения — ужасающие раны от огня, солнца, клыков и когтей: смертельная опасность для Сородичей."/>
                            <CheckBox x:Name="AggravatedDamageToggle" Content="Нанести губительные" Margin="14,0,0,0" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextBrush}" Checked="AggravatedDamageToggle_Changed" Unchecked="AggravatedDamageToggle_Changed"
                                      ToolTip="При включении следующий щелчок по ячейке наносит губительное повреждение в верхний слот.">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="CheckBox">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border x:Name="Box" Width="19" Height="19" CornerRadius="4" BorderThickness="1.5"
                                                                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource InputBrush}" VerticalAlignment="Center">
                                                            <Path x:Name="Tick" Data="M 3,9 L 7,13 16,4" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                                                        </Border>
                                                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                        </DockPanel>
                        <controls:HealthTrackControl x:Name="HealthTrack"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="3,5,3,0" Foreground="{DynamicResource MutedBrush}"
                                   Text="Лёгкие — синяки, ссадины и ушибы: быстро заживают, редко смертельны. &#x0a;Тяжёлые — глубокие раны и переломы: смертного могут быстро убить, вампиру доставляют временные неудобства.&#x0a;Губительные — раны от огня, солнца, клыков и когтей: смертельная опасность для Сородичей."/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- ===== Опыт ===== -->
            <GroupBox Header="Опытность" Style="{StaticResource SectionBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                       
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    
                    </Grid.ColumnDefinitions>
               
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <controls:FieldControl x:Name="ExperienceInput" Label="Опыт"/>
                        <Button Content="Подробнее о закупе" HorizontalAlignment="Right" Padding="10,4" Margin="0,4,0,0"
                                Click="ExperiencePrices_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <controls:FieldControl x:Name="FreebiePointsInput" Label="Свободные пункты"/>
                        <Button Content="Подробнее о закупе" HorizontalAlignment="Right" Padding="10,4" Margin="0,4,0,0"
                                Click="FreebiePrices_Click"/>
                    </StackPanel>
                   
                </Grid>
            </GroupBox>
            

        </StackPanel>
    </ScrollViewer>
</UserControl>
