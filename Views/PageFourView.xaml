<UserControl x:Class="VtM_LoCh_fP.Views.PageFourView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VtM_LoCh_fP.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14,16,20">
            <DockPanel Margin="4,0,4,12">
                <TextBlock DockPanel.Dock="Right" Text="4/5" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="ДОСТОИНСТВА · НЕДОСТАТКИ · ИСТОРИЯ" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}"/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Header="ДОСТОИНСТВА" Style="{StaticResource SectionBoxStyle}">
                    <controls:FieldControl Label="Название · описание · стоимость" Multiline="True" FieldHeight="260"/>
                </GroupBox>
                <GroupBox Grid.Column="1" Header="НЕДОСТАТКИ" Style="{StaticResource SectionBoxStyle}">
                    <controls:FieldControl Label="Название · описание · стоимость" Multiline="True" FieldHeight="260"/>
                </GroupBox>
            </Grid>
            <GroupBox Header="ДИСЦИПЛИНЫ · дополнительные записи" Style="{StaticResource SectionBoxStyle}">
                <controls:FieldControl Label="Дополнительные дисциплины и особенности" Multiline="True" FieldHeight="110"/>
            </GroupBox>
            <GroupBox Header="ИСТОРИЯ" Style="{StaticResource SectionBoxStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <controls:FieldControl Grid.Row="0" Grid.Column="0" Label="Истинный возраст"/>
                    <controls:FieldControl Grid.Row="0" Grid.Column="1" Label="Предыстория" Multiline="True" FieldHeight="70"/>
                    <controls:FieldControl Grid.Row="1" Grid.Column="0" Label="Видимый возраст"/>
                    <controls:FieldControl Grid.Row="1" Grid.Column="1" Label="Дата рождения"/>
                    <controls:FieldControl Grid.Row="2" Grid.Column="0" Label="Дата смерти"/>
                    <controls:FieldControl Grid.Row="2" Grid.Column="1" Label="Отличительные черты · внешность" Multiline="True" FieldHeight="70"/>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
