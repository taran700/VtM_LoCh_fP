<UserControl x:Class="VtM_LoCh_fP.Views.PageThreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,10,12,16">
            <DockPanel Margin="4,0,4,10">
                <TextBlock DockPanel.Dock="Right" Text="3/5" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="ДИСЦИПЛИНЫ" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}"/>
            </DockPanel>
            <TextBlock Text="Выберите дисциплины персонажа, отмечайте освоенные уровни и просматривайте полученные способности в карточках ниже." Style="{StaticResource SectionCaptionStyle}" TextWrapping="Wrap" Margin="4,0,4,10"/>
            <GroupBox Header="Дисциплины персонажа" Style="{StaticResource SectionBoxStyle}">
                <StackPanel>
                    <Button x:Name="OpenDisciplineCatalogButton" Content="Открыть каталог дисциплин" Height="42" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" Click="OpenDisciplineCatalog_Click"/>
                    <StackPanel x:Name="SelectedDisciplinesPanel"/>
                    <Button x:Name="StudyRitualButton" Content="Изучить ритуал" Height="38" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" Visibility="Collapsed" Click="StudyRitual_Click"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Карточки дисциплин" Style="{StaticResource SectionBoxStyle}" Margin="0,12,0,0">
                <StackPanel x:Name="DisciplineCardsPanel">
                    <TextBlock Text="Пока нет изученных способностей." Style="{StaticResource FieldLabelStyle}"/>
                </StackPanel>
            </GroupBox>
            <GroupBox x:Name="RitualsGroupBox" Header="Изученные ритуалы" Style="{StaticResource SectionBoxStyle}" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel x:Name="RitualCardsPanel">
                    <TextBlock Text="Пока нет изученных ритуалов." Style="{StaticResource FieldLabelStyle}"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
