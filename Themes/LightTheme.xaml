<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Светлая тема: белый лист и красный акцент. Текст — тёплый тёмно-коричневый,
         не чистый чёрный, чтобы не контрастировать с белым фоном резко -->
    <SolidColorBrush x:Key="BgBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardHeaderBrush" Color="#FFF8EDED"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FF4A382C"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#FF806A58"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FFB91C1C"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFDC2626"/>
    <SolidColorBrush x:Key="HeadingBrush" Color="#FFB91C1C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFE8C9C9"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SelectedTabTextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#FFF2D4D4"/>


    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFF8EDED"/>
    <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#FFFFF7F7"/>
    <SolidColorBrush x:Key="NoteBackgroundBrush" Color="#FFFFF4E8"/>
    <SolidColorBrush x:Key="CombatCategorySelectedBrush" Color="#FFB91C1C"/>
    <SolidColorBrush x:Key="CombatCategorySelectedBorderBrush" Color="#FFDC2626"/>



    <!-- Глобальные системные цвета выделения: WPF-контролы не должны подставлять голубое выделение Windows. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFF2D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FF4A382C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFF2D4D4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF4A382C"/>

</ResourceDictionary>
